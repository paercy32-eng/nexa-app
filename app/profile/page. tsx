'use client';

import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';

type Me = {
  id: string;
  name: string;
  phone: string;
  balance: number;
  currency: string;
  total_deposited?: number;
  total_withdrawn?: number;
  bound_phone?: string;
  bound_name?: string;
};

export default function ProfilePage() {
  const router = useRouter();
  const [me, setMe] = useState<Me | null>(null);
  const [loading, setLoading] = useState(true);
  
  // Bind Account State
  const [showBindAccount, setShowBindAccount] = useState(false);
  const [bindPhone, setBindPhone] = useState('');
  const [bindName, setBindName] = useState('');
  const [bindLoading, setBindLoading] = useState(false);
  const [bindMsg, setBindMsg] = useState('');

  async function loadMe() {
    const res = await fetch('/api/me?t=' + Date.now(), { cache: 'no-store' });
    if (res.status === 401) {
      router.replace('/login');
      return;
    }
    const data = await res.json();
    setMe(data.user);
    setBindPhone(data.user.bound_phone || '');
    setBindName(data.user.bound_name || '');
    setLoading(false);
  }

  useEffect(() => {
    loadMe();
  }, [router]);

  async function handleBindAccount(e: React.FormEvent) {
    e.preventDefault();
    setBindLoading(true);
    setBindMsg('');
    try {
      const res = await fetch('/api/user/bind-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: bindPhone, fullName: bindName }),
      });
      const data = await res.json();
      if (!res.ok) {
        setBindMsg(data.error || 'Failed to bind account.');
      } else {
        setBindMsg('Account bound successfully!');
        setTimeout(() => {
          setShowBindAccount(false);
          setBindMsg('');
          loadMe();
        }, 1500);
      }
    } catch {
      setBindMsg('Something went wrong.');
    } finally {
      setBindLoading(false);
    }
  }

  async function logout() {
    await fetch('/api/auth/logout', { method: 'POST' });
    router.replace('/login');
    router.refresh();
  }

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-slate-50">
        <div className="w-8 h-8 rounded-full border-2 border-emerald-600 border-t-transparent animate-spin" />
      </div>
    );
  }

  return (
    <main className="min-h-screen px-4 py-6 animate-fade-in pb-24 bg-slate-50">
      
      {/* Header */}
      <div className="flex items-center justify-between px-2 mb-5">
        <div className="flex items-center gap-2">
          <div className="w-10 h-10 bg-emerald-600 rounded-xl shadow-lg shadow-emerald-600/30 flex items-center justify-center">
            <span className="text-white font-black text-xl">N</span>
          </div>
          <div>
            <h1 className="text-lg font-black text-slate-900 leading-tight">NEXA</h1>
            <p className="text-[10px] text-emerald-600 font-bold tracking-widest uppercase">Capital</p>
          </div>
        </div>
        <div className="text-right">
          <div className="text-[11px] text-slate-500 font-medium">Signed in</div>
          <div className="text-sm font-semibold text-slate-900">{me?.name}</div>
        </div>
      </div>

      {/* Balance Card */}
      <div className="bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-3xl p-5 mb-5 shadow-lg shadow-emerald-600/20">
        <div className="text-xs text-emerald-100 font-semibold mb-1 uppercase tracking-wider">Available Balance</div>
        <div className="text-4xl font-black text-white mb-5 drop-shadow-md">
          {me?.currency} {Number(me?.balance || 0).toLocaleString()}
        </div>
        
        <div className="grid grid-cols-2 gap-3">
          <div className="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-3">
            <div className="text-[10px] text-emerald-100 font-bold uppercase mb-0.5">Total Deposited</div>
            <div className="text-sm font-bold text-white">
              {me?.currency} {Number(me?.total_deposited || 0).toLocaleString()}
            </div>
          </div>
          <div className="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-3">
            <div className="text-[10px] text-emerald-100 font-bold uppercase mb-0.5">Total Withdrawn</div>
            <div className="text-sm font-bold text-white">
              {me?.currency} {Number(me?.total_withdrawn || 0).toLocaleString()}
            </div>
          </div>
        </div>
      </div>

      {/* Quick Actions 2x2 Grid */}
      <div className="grid grid-cols-2 gap-3 mb-6">
        
        {/* Transaction History */}
        <button onClick={() => router.push('/history')} className="bg-white border border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2 active:scale-[0.98] transition shadow-sm">
          <div className="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 mb-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
          </div>
          <div className="text-xs font-bold text-slate-900 leading-tight">Transaction History</div>
        </button>

        {/* Bind Account */}
        <button onClick={() => setShowBindAccount(true)} className="bg-white border border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2 active:scale-[0.98] transition shadow-sm">
          <div className="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 mb-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div className="text-xs font-bold text-slate-900 leading-tight">Bind Account</div>
          <div className="text-[9px] text-slate-500 truncate w-full px-1">{me?.bound_phone ? me.bound_phone : 'Not bound'}</div>
        </button>

        {/* Rewards */}
        <button onClick={() => router.push('/rewards')} className="bg-white border border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2 active:scale-[0.98] transition shadow-sm">
          <div className="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 mb-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M8 21h8"></path><path d="M12 17v4"></path><path d="M7 4h10l1 7H6L7 4z"></path><path d="M5 11h14"></path></svg>
          </div>
          <div className="text-xs font-bold text-slate-900 leading-tight">Rewards</div>
        </button>

        {/* Log out */}
        <button onClick={logout} className="bg-white border border-red-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2 active:scale-[0.98] transition shadow-sm">
          <div className="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center text-red-600 mb-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </div>
          <div className="text-xs font-bold text-red-600 leading-tight">Log out</div>
        </button>
      </div>

      {/* Bind Account Modal */}
      {showBindAccount && (
        <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50" onClick={() => setShowBindAccount(false)}>
          <div className="w-full max-w-md bg-white rounded-t-3xl p-5" onClick={(e) => e.stopPropagation()}>
            <div className="flex justify-between items-start mb-4">
              <div>
                <div className="text-lg font-bold text-slate-900">Bind Account</div>
                <div className="text-xs text-slate-500">Secure your withdrawals</div>
              </div>
              <button onClick={() => setShowBindAccount(false)} className="text-slate-400 text-xl">×</button>
            </div>
            
            <form onSubmit={handleBindAccount} className="space-y-4">
              <div>
                <label className="block text-[10px] text-slate-500 font-bold mb-1">MOBILE MONEY NUMBER</label>
                <input type="tel" value={bindPhone} onChange={(e) => setBindPhone(e.target.value)} placeholder="0700123456" className="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" required />
              </div>
              <div>
                <label className="block text-[10px] text-slate-500 font-bold mb-1">FULL REGISTERED NAME</label>
                <input type="text" value={bindName} onChange={(e) => setBindName(e.target.value)} placeholder="As registered on mobile money" className="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" required />
              </div>

              {bindMsg && <div className="text-xs text-emerald-700 bg-emerald-50 rounded-xl px-3 py-2 border border-emerald-200">{bindMsg}</div>}

              <button type="submit" className="w-full bg-emerald-600 text-white font-bold py-3.5 rounded-xl active:scale-[0.98] transition disabled:opacity-50" disabled={bindLoading}>
                {bindLoading ? 'Saving…' : 'Bind Account'}
              </button>
            </form>
            <button onClick={() => setShowBindAccount(false)} className="w-full mt-3 border border-slate-200 text-slate-600 font-semibold py-3 rounded-xl active:scale-[0.98] transition bg-slate-50">Close</button>
          </div>
        </div>
      )}
    </main>
  );
}
